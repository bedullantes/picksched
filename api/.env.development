# Development settings, loaded automatically when APP_ENV is development
# (the default without NODE_ENV=production). Committed on purpose: it holds
# NO real secrets, only placeholders for the local simulators.
#
# Put your own values (a real SESSION_SECRET, PayMongo/SendGrid/Twilio TEST
# keys) in api/.env.local, which is git-ignored and takes precedence.
# Variables already set in the shell always win over both files.
#
# Staging and production never read .env files: see .env.staging.example,
# .env.production.example and docs/deployment.md.

DATABASE_URL=postgres://postgres@localhost:5432/picksched
DATABASE_SSL=disable
PORT=3000
APP_BASE_URL=http://localhost:5173
LOG_LEVEL=debug

# PayMongo simulator (npm run dev:paymongo -w api). Live keys (sk_live_) are
# refused outside production.
PAYMONGO_SECRET_KEY=sk_test_local
PAYMONGO_WEBHOOK_SECRET=whsk_local
PAYMONGO_API_BASE=http://localhost:4010/v1

# SendGrid + Twilio simulator (npm run dev:messaging -w api); sent messages
# are listed at http://localhost:4020/_sent
SENDGRID_API_KEY=SG.local
SENDGRID_FROM_EMAIL=bookings@localhost
SENDGRID_API_BASE=http://localhost:4020
TWILIO_ACCOUNT_SID=AClocal
TWILIO_AUTH_TOKEN=local
TWILIO_FROM_NUMBER=+15005550006
TWILIO_API_BASE=http://localhost:4020
