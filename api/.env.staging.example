# STAGING: template only. This file is never loaded by the app.
# Store each value in the staging environment's secret manager / platform
# environment settings (or mount it as a file and set NAME_FILE=/path).
# Staging uses provider TEST credentials only: PayMongo live keys are refused.

APP_ENV=staging
NODE_ENV=production
PORT=3000
APP_BASE_URL=https://staging.picksched.example

# Database: TLS with certificate verification. The password lives only in the secret store.
DATABASE_URL=<secret: postgres://picksched_api:PASSWORD@staging-db.internal:5432/picksched>
DATABASE_SSL=verify-full
# DATABASE_CA_CERT_FILE=/run/secrets/db-ca.pem     # if the server uses a private CA
DB_POOL_MAX=10

SESSION_SECRET=<secret: openssl rand -base64 48>

# PayMongo TEST mode (sk_test_ / its own test webhook)
PAYMONGO_SECRET_KEY=<secret: sk_test_...>
PAYMONGO_WEBHOOK_SECRET=<secret: whsk_...>

# SendGrid (sandbox mode validates without delivering; turn off to test real delivery)
SENDGRID_API_KEY=<secret: SG....>
SENDGRID_FROM_EMAIL=bookings@staging.picksched.example
SENDGRID_SANDBOX_MODE=false

# Twilio (test or trial account)
TWILIO_ACCOUNT_SID=<secret: AC...>
TWILIO_AUTH_TOKEN=<secret>
TWILIO_MESSAGING_SERVICE_SID=<MG...>
TWILIO_STATUS_CALLBACK_URL=https://staging.picksched.example/api/webhooks/twilio/status

# Proxy / logging
TRUST_PROXY=1
LOG_LEVEL=info
# ERROR_WEBHOOK_URL=<secret: alerting webhook>
