# PRODUCTION: template only. This file is never loaded by the app.
# Every <secret: ...> value goes into the production secret manager
# (AWS Secrets Manager / SSM, GCP Secret Manager, Azure Key Vault, Doppler,
# Vault, or your platform's encrypted environment settings) and is injected
# at runtime as an environment variable or a mounted file (NAME_FILE=/path).
# The server refuses to start if production rules are not met (live PayMongo
# keys, TLS-verified database, SendGrid without sandbox, HSTS, secure cookies...).

APP_ENV=production
NODE_ENV=production
PORT=3000
APP_BASE_URL=https://app.picksched.example

# Database: TLS with full certificate verification and connection pooling.
DATABASE_URL=<secret: postgres://picksched_api:PASSWORD@prod-db.internal:5432/picksched>
DATABASE_SSL=verify-full
# DATABASE_CA_CERT_FILE=/run/secrets/db-ca.pem     # provider CA bundle (e.g. RDS global bundle)
DB_POOL_MAX=20                    # per instance; keep instances x DB_POOL_MAX below the server's max_connections
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_MAX_LIFETIME_SECONDS=1800      # recycle connections (failover, credential rotation)

SESSION_SECRET=<secret: openssl rand -base64 48>
BCRYPT_ROUNDS=12

# PayMongo LIVE mode (sk_live_ / the live webhook's signing secret)
PAYMONGO_SECRET_KEY=<secret: sk_live_...>
PAYMONGO_WEBHOOK_SECRET=<secret: whsk_...>

# SendGrid
SENDGRID_API_KEY=<secret: SG....>
SENDGRID_FROM_EMAIL=bookings@picksched.example

# Twilio (or SMS_PROVIDER=off for email only)
TWILIO_ACCOUNT_SID=<secret: AC...>
TWILIO_AUTH_TOKEN=<secret>
TWILIO_MESSAGING_SERVICE_SID=<MG...>
TWILIO_STATUS_CALLBACK_URL=https://app.picksched.example/api/webhooks/twilio/status

# Security (these are the production defaults)
TRUST_PROXY=1                     # number of proxies / load balancers in front of the app
HSTS=true
HTTPS_REDIRECT=true
COOKIE_SECURE=true
# CSP_REPORT_URI=https://<your CSP report collector>

# Logging / error tracking
LOG_LEVEL=info
LOG_FORMAT=json
ACCESS_LOG=true
# ERROR_WEBHOOK_URL=<secret: alerting webhook (Slack, PagerDuty Events, etc.)>
